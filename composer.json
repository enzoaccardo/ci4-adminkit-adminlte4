{
    "name": "enzoaccardo/ci4-adminkit-adminlte4",
    "description": "Tema AdminLTE 4 (Bootstrap 5) per ci4-adminkit: layout pannello admin + pagine front auth, asset precompilati + sorgenti Vite.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Vincenzo Accardo",
            "email": "vincenzo.accardo@w3style.it"
        }
    ],
    "require": {
        "php": "^8.2",
        "codeigniter4/framework": "^4.7",
        "smarty/smarty": "^5.8",
        "enzoaccardo/ci4-adminkit": "^0.1"
    },
    "autoload": {
        "psr-4": {
            "AdminKit\\AdminLTE\\": "src/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    }
}
